<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Panel>
    <Panel
      Id="equipmentFrame"
      HorizontalAlignment="Left"
      VerticalAlignment="Center"
      Height="480"
      Left="410"
      StyleName="questPanel">

      <VerticalStackPanel Width="300" Spacing="0">

        <!-- header -->
        <HorizontalStackPanel>
          <Label Text="Equipment" StyleName="title"/>
        </HorizontalStackPanel>

        <!-- equipment slots layout -->
        <Panel Top="28">
          <VerticalStackPanel Spacing="2">
            <HorizontalStackPanel Spacing="2">
              <VerticalStackPanel Spacing="2">
                <ImageButton Id="eqHead"        Width="48" Height="48" StyleName="slot"/>
                <ImageButton Id="eqTorso"       Width="48" Height="48" StyleName="slot"/>
                <ImageButton Id="eqHands"       Width="48" Height="48" StyleName="slot"/>
                <ImageButton Id="eqLegs"        Width="48" Height="48" StyleName="slot"/>
              </VerticalStackPanel>

              <Image Id="characterImage" Width="148" Height="148"></Image>

              <VerticalStackPanel Spacing="2">
                <ImageButton Id="eqNecklace"    Width="48" Height="48" StyleName="slot"/>
                <ImageButton Id="eqCape"        Width="48" Height="48" StyleName="slot"/>
                <ImageButton Id="eqContainment" Width="48" Height="48" StyleName="slot"/>
                <ImageButton Id="eqBelt"        Width="48" Height="48" StyleName="slot"/>
              </VerticalStackPanel>
            </HorizontalStackPanel>
            
            <HorizontalStackPanel Spacing="3">
              <ImageButton Id="eqPet0"        Width="48" Height="48" StyleName="slot"/>
              <ImageButton Id="eqPet1"        Width="48" Height="48" StyleName="slot"/>
              <ImageButton Id="eqWeapon"      Width="48" Height="48" StyleName="slot"/>
              <ImageButton Id="eqRing0"       Width="48" Height="48" StyleName="slot"/>
              <ImageButton Id="eqRing1"       Width="48" Height="48" StyleName="slot"/>
            </HorizontalStackPanel>
          </VerticalStackPanel>
          
          

        </Panel>

      </VerticalStackPanel>

    </Panel>
  </Panel>
</Project>