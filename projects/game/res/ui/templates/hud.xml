<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Panel>

    <VerticalStackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                        Spacing="6" Left="16" Top="16">

      <Panel Width="180" Height="14">
        <HorizontalProgressBar Id="healthBar" StyleName="healthBar" 
                               Width="180" Height="14" Value="80"/>
        <Label Id="lblHealth" Text="60/100"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               TextColor="White"
               FontScale="0.9"/>
      </Panel>

      <Panel Width="180" Height="14">
        <HorizontalProgressBar Id="manaBar" StyleName="manaBar" 
                               Width="180" Height="14" Value="60"/>
        <Label Id="lblMana" Text="60/100"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               TextColor="White"/>
      </Panel>

      <Panel Width="180" Height="14">
        <HorizontalProgressBar Id="staminaBar" StyleName="staminaBar" 
                               Width="180" Height="14" Value="60"/>
        <Label Id="lblStamina" Text="60/100"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               TextColor="White"/>
      </Panel>

    </VerticalStackPanel>

  </Panel>
</Project>