<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Panel>
    <Panel
      Id="inventoryFrame"
      HorizontalAlignment="Left"
      VerticalAlignment="Center"
      Height="480"
      Left="80"
      StyleName="questPanel">

      <VerticalStackPanel Spacing="2">

        <!-- header -->
        <HorizontalStackPanel>
          <Label Text="Inventory" StyleName="title"/>
        </HorizontalStackPanel>

        <!-- sort tabs -->
        <HorizontalStackPanel Id="sortTabs" Spacing="2">
          <ImageButton Id="tabAll"        Width="26" Height="26"  StyleName="slot"/>
          <ImageButton Id="tabWeapons"        Width="26" Height="26"  StyleName="slot"/>
          <ImageButton Id="tabArmor"        Width="26" Height="26" StyleName="slot"/>
          <ImageButton Id="tabAccessories"        Width="26" Height="26"  StyleName="slot"/>
          <ImageButton Id="tabMaterials"        Width="26" Height="26" StyleName="slot"/>
          <ImageButton Id="tabConsumables"        Width="26" Height="26" StyleName="slot"/>
          <ImageButton Id="tabKeys"        Width="26" Height="26" StyleName="slot"/>
          <ImageButton Id="tabQuestItems"        Width="26" Height="26" StyleName="slot"/>
          <ImageButton Id="tabCurrencies"        Width="26" Height="26" StyleName="slot"/>

          <VerticalStackPanel Spacing="2">
            <ImageButton Id="sortAZ" Width="12" Height="12" StyleName="slot"/>
            <ImageButton Id="sortVal" Width="12" Height="12" StyleName="slot"/>
          </VerticalStackPanel>
          <VerticalStackPanel Spacing="2">
            <ImageButton Id="sortRarity" Width="12" Height="12" StyleName="slot"/>
            <ImageButton Id="sortNewest" Width="12" Height="12" StyleName="slot"/>
          </VerticalStackPanel>
        </HorizontalStackPanel>

        <!-- item grid (scrollable) -->
        <ScrollViewer Id="inventoryScroll" Width="260" Height="388">
          <Panel Id="inventoryGrid" Width="400" Height="2000"/>
        </ScrollViewer>

      </VerticalStackPanel>

    </Panel>
  </Panel>
</Project>